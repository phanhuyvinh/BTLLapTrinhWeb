@{
    ViewData["Title"] = "Chính sách giao hàng";
}
<div class="section" style="max-width:800px">
    <h1 style="margin-bottom:16px">Chính sách giao hàng</h1>
    <div class="panel">
        <p>Nội thành TP.HCM và Hà Nội: giao trong 2–4 giờ với đơn đặt trước 20:00.</p>
        <p class="mt-8">Các tỉnh thành khác: 1–3 ngày làm việc qua đối tác vận chuyển.</p>
        <p class="mt-8">Phí giao hàng hiển thị ở bước thanh toán. Đơn từ 300.000đ được miễn phí nội thành.</p>
        <p class="mt-8">Thuốc kê đơn chỉ giao sau khi dược sĩ xác nhận đơn thuốc hợp lệ.</p>
    </div>
</div>